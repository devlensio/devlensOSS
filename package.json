{
  "name": "@devlensio/cli",
  "version": "0.5.3",
  "description": "DevLens CLI — turn any TypeScript, JavaScript, Python, Go, Rust, or Java codebase into a queryable graph of nodes and typed edges, with per-node functional, technical, and security summaries. Commands: detect, analyze, summarize, overview, top-nodes, find-nodes, nodes-in-path, get-node, get-summaries, node-code, blast-radius, khop, subgraph, cycles, diff, check-freshness, coverage, security, security-brief, architecture, review-pr, onboard-tour, get-context, config, init, repos, graphs, status, doctor, serve, mcp.",
  "keywords": [
    "codebase",
    "code-graph",
    "static-analysis",
    "architecture",
    "impact-analysis",
    "security",
    "typescript",
    "javascript",
    "python",
    "go",
    "rust",
    "java",
    "mcp",
    "ai",
    "llm"
  ],
  "mcpName": "io.github.devlensio/devlens",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlensio/devlensOSS.git"
  },
  "bin": {
    "devlens": "bin/devlens.cjs"
  },
  "files": [
    "bin/devlens.cjs",
    "scripts/postinstall.mjs"
  ],
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --names engine,frontend --prefix-colors cyan,magenta \"bun run dev:engine\" \"bun run dev:frontend\"",
    "dev:engine": "bun --watch src/server/index.ts",
    "dev:frontend": "cd frontend && bun run dev",
    "start": "bun scripts/start.mjs",
    "build:ui": "cd frontend && bun run build",
    "build:binaries": "node scripts/build-binaries.mjs",
    "stage:binaries": "node scripts/stage-binaries.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "optionalDependencies": {
    "@devlensio/cli-darwin-arm64": "0.5.3",
    "@devlensio/cli-darwin-x64": "0.5.3",
    "@devlensio/cli-linux-x64": "0.5.3",
    "@devlensio/cli-linux-arm64": "0.5.3",
    "@devlensio/cli-windows-x64": "0.5.3"
  },
  "trustedDependencies": [
    "devlensio"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "commander": "^15.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^17.3.1",
    "lru-cache": "^11.5.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "devlensio": "^1.0.1"
  }
}
